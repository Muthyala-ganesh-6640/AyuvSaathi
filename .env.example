# Copy this file to .env.local and fill in values you want to enable.
# The app runs in a local development store without these services.
# Never commit real secrets.

# Required in production. In development a secret is generated into .data/ if omitted.
AUTH_SECRET=

# Public site URL used in password-reset links
APP_URL=http://localhost:3000

# --- Supabase (optional production backend) ---
# Leave empty to use the local encrypted-at-rest-style JSON store (gitignored).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this in client code.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider (optional). Credentials are server-only. ---
# openai | groq | anthropic | compatible
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# For OpenAI-compatible gateways (Groq, Azure, local, etc.)
AI_BASE_URL=
AI_TIMEOUT_MS=45000

# --- Maps (optional). Default nearby search uses OpenStreetMap Nominatim + Overpass. ---
# If set, the app can also call Google Places (server-side only).
GOOGLE_MAPS_API_KEY=
# The browser Maps JavaScript key, if you enable the Google map embed. Restrict it by HTTP referrer.
NEXT_PUBLIC_GOOGLE_MAPS_JS_KEY=

# SMTP is required to actually send password-reset emails. Without it, reset tokens are
# shown only on the server console in development and never emailed.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional MySQL demo seed accounts. Use unique local-only passwords (12+ characters).
DEMO_PATIENT_PASSWORD=
DEMO_DOCTOR_PASSWORD=
